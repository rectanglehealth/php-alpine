PHP_85_VERSION := 8.5.12
PHP_85_SHA256 := 08bc2eba2a588654ade1357174aa646b761556c862dda0678345ee29ed481209
PHP_85_GPG_KEYS := 1198C0117593497A5EC5C199286AF1F9897469DC 49D9AF6BC72A80D6691719C8AA23F5BE9C7097D4 D95C03BC702BE9515344AE3374E44BC9067701A5

# Defaults used by `make build` and `make test`.
PHP_VERSION ?= $(PHP_85_VERSION)
PHP_SERIES ?= 8.5
PHP_SHA256 ?= $(PHP_85_SHA256)
PHP_GPG_KEYS ?= $(PHP_85_GPG_KEYS)
IMAGE ?= $(IMAGE_REPOSITORY):8.5.12
IMAGE_ALIAS ?= $(IMAGE_REPOSITORY):8.5

.PHONY: build test build-all test-all \
	build-8.2 build-8.3 build-8.4 build-8.5 \
	test-8.2 test-8.3 test-8.4 test-8.5 \
	build-frankenphp test-frankenphp

build:
	docker build --pull \
		--build-arg PHP_VERSION=$(PHP_VERSION) \
		--build-arg PHP_SERIES=$(PHP_SERIES) \
		--build-arg ALPINE_VERSION=$(ALPINE_VERSION) \
		--build-arg PHP_SHA256=$(PHP_SHA256) \
		--build-arg PHP_GPG_KEYS="$(PHP_GPG_KEYS)" \
		--tag $(IMAGE) \
		$(if $(IMAGE_ALIAS),--tag $(IMAGE_ALIAS)) .

test: build
	docker run --rm $(IMAGE) php -r 'exit(PHP_VERSION === "$(PHP_VERSION)" ? 0 : 1);'
	docker run --rm $(IMAGE) sh -c 'grep -Eq "^$(ALPINE_VERSION)\\." /etc/alpine-release'
	docker run --rm $(IMAGE) php -r 'exit(extension_loaded("Zend OPcache") && extension_loaded("sodium") ? 0 : 1);'
	docker run --rm $(IMAGE) sh -c 'command -v docker-php-ext-install >/dev/null && command -v docker-php-entrypoint >/dev/null'
	docker run --rm $(IMAGE) sh -c 'test -s /usr/src/php.tar.xz && docker-php-source extract && test -f /usr/src/php/configure && docker-php-source delete'
	docker run --rm $(IMAGE) php-fpm --test

build-8.2:
	$(MAKE) build PHP_VERSION=$(PHP_82_VERSION) PHP_SERIES=8.2 PHP_SHA256=$(PHP_82_SHA256) \
		PHP_GPG_KEYS="$(PHP_82_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_82_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.2

build-8.3:
	$(MAKE) build PHP_VERSION=$(PHP_83_VERSION) PHP_SERIES=8.3 PHP_SHA256=$(PHP_83_SHA256) \
		PHP_GPG_KEYS="$(PHP_83_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_83_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.3

build-8.4:
	$(MAKE) build PHP_VERSION=$(PHP_84_VERSION) PHP_SERIES=8.4 PHP_SHA256=$(PHP_84_SHA256) \
		PHP_GPG_KEYS="$(PHP_84_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_84_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.4

build-8.5:
	$(MAKE) build PHP_VERSION=$(PHP_85_VERSION) PHP_SERIES=8.5 PHP_SHA256=$(PHP_85_SHA256) \
		PHP_GPG_KEYS="$(PHP_85_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_85_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.5

test-8.2:
	$(MAKE) test PHP_VERSION=$(PHP_82_VERSION) PHP_SERIES=8.2 PHP_SHA256=$(PHP_82_SHA256) \
		PHP_GPG_KEYS="$(PHP_82_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_82_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.2

test-8.3:
	$(MAKE) test PHP_VERSION=$(PHP_83_VERSION) PHP_SERIES=8.3 PHP_SHA256=$(PHP_83_SHA256) \
		PHP_GPG_KEYS="$(PHP_83_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_83_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.3

test-8.4:
	$(MAKE) test PHP_VERSION=$(PHP_84_VERSION) PHP_SERIES=8.4 PHP_SHA256=$(PHP_84_SHA256) \
		PHP_GPG_KEYS="$(PHP_84_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_84_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.4

test-8.5:
	$(MAKE) test PHP_VERSION=$(PHP_85_VERSION) PHP_SERIES=8.5 PHP_SHA256=$(PHP_85_SHA256) \
		PHP_GPG_KEYS="$(PHP_85_GPG_KEYS)" IMAGE=$(IMAGE_REPOSITORY):$(PHP_85_VERSION) IMAGE_ALIAS=$(IMAGE_REPOSITORY):8.5

build-all: build-8.2 build-8.3 build-8.4 build-8.5

test-all: test-8.2 test-8.3 test-8.4 test-8.5

build-frankenphp:
	docker buildx build --load --pull \
		--platform linux/amd64 \
		--file frankenphp/php-zts.Dockerfile \
		--tag $(FRANKENPHP_PHP_BASE_IMAGE) .
	docker buildx build --load --pull \
		--platform linux/amd64 \
		--build-context php-base=$(FRANKENPHP_PHP_BASE) \
		--build-context golang-base=$(FRANKENPHP_GO_BASE) \
		--file alpine.Dockerfile \
		--target runner \
		--build-arg FRANKENPHP_VERSION=$(FRANKENPHP_VERSION) \
		--tag $(FRANKENPHP_IMAGE) \
		https://github.com/php/frankenphp.git#$(FRANKENPHP_COMMIT)

test-frankenphp: build-frankenphp
	docker run --rm --platform linux/amd64 $(FRANKENPHP_IMAGE) php -r \
		'exit(PHP_VERSION === "$(FRANKENPHP_PHP_VERSION)" && PHP_ZTS === 1 ? 0 : 1);'
	docker run --rm --platform linux/amd64 $(FRANKENPHP_IMAGE) frankenphp version | grep -F '$(FRANKENPHP_VERSION)'
